{
	"name": "vibratone",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"clean": "rm -rf .svelte-kit build coverage test-results",
		"dev": "vite dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"test": "bun run test:unit -- --run",
		"test:ci": "bun run test:unit -- --run",
		"test:e2e": "playwright install && bun run test:e2e:production && bun run test:e2e:development",
		"test:e2e:development": "bun scripts/run-playwright-project.ts development",
		"test:e2e:production": "bun scripts/run-playwright-project.ts production",
		"test:unit": "vitest",
		"typecheck": "bun run check",
		"verify:workspace-resolution": "bun scripts/verify-octavian-source.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.4",
		"@vitest/browser-playwright": "^5.0.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.2.2",
		"vitest": "^5.0.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@lostgradient/cinder": "0.26.0",
		"lucide-svelte": "1.0.1",
		"octavian": "workspace:*",
		"vexflow": "5.0.0",
		"web-audio-api": "^1.5.6"
	}
}
