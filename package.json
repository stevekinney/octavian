{
  "name": "octavian-monorepo",
  "private": true,
  "description": "Workspace for the Octavian music theory library.",
  "license": "MIT",
  "author": "Steve Kinney <hello@stevekinney.net>",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "clean": "turbo run clean && rm -rf .turbo coverage",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "lint": "bun run lint:root && turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:root": "oxlint --type-aware --tsconfig ./tsconfig.json scripts",
    "package:check": "turbo run package:check",
    "prepare": "lefthook install",
    "smoke:tarball": "turbo run smoke:tarball",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "typecheck": "bun run typecheck:root && turbo run typecheck",
    "typecheck:root": "tsc --noEmit --project tsconfig.json",
    "typecheck:test": "turbo run typecheck:test",
    "validate": "bun run format:check && bun run lint && bun run typecheck && bun run typecheck:test && bun run test && bun run build && bun run package:check && bun run validate:artifacts && bun run smoke:tarball",
    "validate:artifacts": "turbo run validate:artifacts",
    "verify:release-version": "bun run --cwd packages/octavian verify:release-version"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "chalk": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "sort-package-json": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.14.0"
  },
  "catalog": {
    "@types/bun": "^1.4.2",
    "chalk": "^6.0.0",
    "lefthook": "^2.1.14",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  }
}
